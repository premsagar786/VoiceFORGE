# VoiceForge environment — copy to .env and fill in.
# Everything the browser needs is prefixed NEXT_PUBLIC_; every secret below stays server-side only.

# ── Required for everything ────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000
CORS_ORIGINS=http://localhost:3000
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ENCRYPTION_KEY=
# postgresql://voiceforge:voiceforge@localhost:5434/voiceforge (docker-compose maps 5434 -> 5432)
DATABASE_URL=

# ── Voice (ElevenLabs) — https://elevenlabs.io → Profile → API Keys ────────
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_DEFAULT_MODEL_ID=

# ── Generation (LLM) ───────────────────────────────────────────────────────
# openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL_GENERATE=
LLM_MODEL_SUMMARY=
EMBEDDING_MODEL=

# ── Calendar tool (optional; feature shows "not connected" if absent) ──────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Demo / limits ──────────────────────────────────────────────────────────
HUMAN_TRANSFER_NUMBER=
RATE_LIMIT_PER_MIN=30
MAX_CALL_SECONDS=300
MONTHLY_BUDGET_INR=500

# ── Optional ───────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# TELEPHONY_PROVIDER=
# SENTRY_DSN=
LOG_LEVEL=info
WEBHOOK_SIGNING_SECRET=
